{
  "name": "imprimare-preturi",
  "version": "1.0.3",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && dotenv -e .env -- electron-builder --win --publish always",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild:electron"
  },
  "keywords": [],
  "author": "Interdax",
  "license": "ISC",
  "build": {
    "appId": "com.interdax.printnew",
    "productName": "Imprimare Preturi",
    "copyright": "Copyright © Interdax",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon-source.png",
        "to": "icon-source.png"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alinoancea",
        "repo": "price_printing",
        "channel": "latest",
        "private": false
      }
    ],
    "nsis": {
      "installerIcon": "build/icon.ico",
      "artifactName": "${productName} Setup.${ext}",
      "uninstallDisplayName": "${productName}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "node-abi": "^4.28.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^2.0.3",
    "jsbarcode": "^3.12.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wait-on": "^9.0.4"
  }
}
